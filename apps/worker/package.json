{
  "name": "@weshot/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.20.1",
    "@ghostery/adblocker-playwright": "2.20.1",
    "@prisma/client": "6.19.3",
    "@sentry/node": "11.8.0",
    "@weshot/server": "workspace:*",
    "@weshot/shared": "workspace:*",
    "bullmq": "5.81.5",
    "ffmpeg-static": "5.3.0",
    "ioredis": "^5.8.0",
    "ipaddr.js": "2.5.0",
    "playwright": "1.56.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.13",
    "@weshot/frame": "workspace:*",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^4.0.5"
  }
}
