{
  "name": "@weshot/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@weshot/shared": "workspace:*",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^4.0.5"
  }
}
