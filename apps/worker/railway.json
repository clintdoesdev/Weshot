{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/worker/Dockerfile",
    "watchPatterns": [
      "apps/worker/**",
      "packages/shared/**",
      "packages/server/**",
      "pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "startCommand": "node apps/worker/dist/index.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
