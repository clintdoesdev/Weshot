{
  "name": "weshot",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @weshot/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @weshot/web test:e2e",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "15.5.28",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@napi-rs/canvas",
      "unrs-resolver",
      "msgpackr-extract"
    ],
    "ignoredBuiltDependencies": [
      "core-js"
    ]
  }
}
