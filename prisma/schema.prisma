// Shared by apps/web and apps/worker. Product spec §4.8.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobKind {
  CAPTURE
  RECORD
}

model Job {
  id         String   @id @default(cuid())
  kind       JobKind
  status     String
  url        String
  /// sha256(ip + daily salt), never the raw IP
  ipHash     String
  assetKey   String?
  errorCode  String?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Share {
  /// 10-char nanoid
  id         String   @id
  assetKey   String
  /// image | video
  kind       String
  width      Int
  height     Int
  /// sha256(deleteToken)
  deleteHash String
  /// createdAt + 30 days
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}
