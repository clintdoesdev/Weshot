# ---------- web ----------
DATABASE_URL=postgresql://weshot:weshot@localhost:5432/weshot
REDIS_URL=redis://localhost:6379
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=weshot
R2_PUBLIC_BASE_URL=https://cdn.weshot.app
# Cloudflare test keys (always pass). Replace in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
IP_HASH_SALT=change-me
# Production: https://weshot.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# ---------- worker (plus DATABASE_URL, REDIS_URL, R2_*) ----------
WORKER_CONCURRENCY=4
CAPTURE_TIMEOUT_MS=30000

# ---------- local development only (see DECISIONS.md) ----------
# When R2_ACCOUNT_ID is empty, files are stored on disk here and served by the web app at /api/files/*.
STORAGE_DIR=
# Secret used to sign local upload URLs and the expiry cron call.
CRON_SECRET=change-me
