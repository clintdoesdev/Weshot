# Nothing is required. WeShot runs with an empty environment.

# Optional: shared rate limits across server instances (Vercel's Redis integration sets this for you).
REDIS_URL=
# Optional: Cloudflare Turnstile bot check on link captures (both keys, or neither).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: salt for hashing IPs in rate limits.
IP_HASH_SALT=
# Optional: your public URL (Open Graph tags, sitemap). Defaults to https://weshot.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional monitoring.
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
